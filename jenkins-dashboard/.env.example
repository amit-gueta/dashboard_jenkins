# PostgreSQL Configuration
POSTGRES_USER=jenkins_user
POSTGRES_PASSWORD=jenkins_password
POSTGRES_DB=jenkins_dashboard_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres_db:5432/${POSTGRES_DB}

# Redis Configuration
REDIS_URL=redis://redis_cache:6379/0

# Backend API Configuration
PROJECT_NAME="Jenkins Pipeline Dashboard API"

# Data Integration Configuration
# Multiple Jenkins URLs can be comma-separated
JENKINS_URLS=http://your-jenkins-instance1.com:8080,http://your-jenkins-instance2.com:8080
JENKINS_USER=your_jenkins_user # Optional, for authenticated access
JENKINS_TOKEN=your_jenkins_api_token # Optional
POLLING_INTERVAL_SECONDS=120 # How often the collector polls Jenkins
# Comma-separated list of job paths to monitor by default
# Example: job/MyProject/job/main,job/AnotherGroup/job/DevPipeline/job/MR-.* (regex might need specific handling in collector)
DEFAULT_MONITORED_JOBS_PATHS=job/your-group/job/your-project/job/your-MR-pipeline-template,job/another-project/job/main

# This is the URL the data_integration service will use to post data TO the backend.
# Inside Docker Compose, 'backend' is the hostname of the backend service.
BACKEND_API_URL=http://backend:8000/api/builds/ingress # 'ingress' is a hypothetical endpoint

# Frontend Configuration (if any direct env vars needed by frontend build process)
# Example: REACT_APP_API_BASE_URL=/api (usually handled by proxy)

# General Application Settings
TZ=UTC # Set timezone for containers
PYTHONUNBUFFERED=1 # Ensures Python logs appear without delay in Docker
