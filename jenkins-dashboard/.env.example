# PostgreSQL Configuration
POSTGRES_USER=jenkins_user
POSTGRES_PASSWORD=jenkins_password
POSTGRES_DB=jenkins_dashboard_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres_db:5432/${POSTGRES_DB}

# Backend API Configuration
PROJECT_NAME="Jenkins Pipeline Dashboard API"
# Add any other backend-specific environment variables here.
# For example, if the backend needs to know its own public URL or default settings.

# Frontend Configuration (if any direct env vars needed by frontend build process)
# Example: REACT_APP_API_BASE_URL=/api (usually handled by proxy)

# General Application Settings
TZ=UTC
PYTHONUNBUFFERED=1
